    {
      "parameters": {
        "jsCode": "// 1. Получаем новые вакансии из первого кода\nconst newJobs = $('Code in JavaScript').all();\n\n// 2. Получаем данные из Google Таблицы\nconst sheetRows = $('Get row(s) in sheet').all();\n\n// Если таблица пустая или в ней только пустой объект — отдаем все новые вакансии\nif (!sheetRows.length || !sheetRows[0].json || Object.keys(sheetRows[0].json).length === 0) {\n  return newJobs;\n}\n\n// 3. Собираем список всех имеющихся job_id из таблицы\nconst existingIds = new Set(\n  sheetRows\n    .map(row => String(row.json.job_id || '').trim())\n    .filter(Boolean)\n);\n\n// 4. Фильтруем: оставляем только те вакансии, ID которых нет в таблице\nconst uniqueJobs = newJobs.filter(job => {\n  const jobId = String(job.json.job_id || '').trim();\n  return jobId && !existingIds.has(jobId);\n});\n\nreturn uniqueJobs;"
      },
