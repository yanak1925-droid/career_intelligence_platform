    {
      "parameters": {
        "jsCode": "// Приводим ответ RemoteOK к структуре таблицы.\n// Первый элемент выдачи — юридическое уведомление, а не вакансия.\nconst jobs = items.slice(1);\n\n// Берём только свежие объявления: в выдаче попадаются вакансии месячной\n// давности, и без отбора таблица наполняется старыми датами.\nconst MAX_AGE_DAYS = 7;\nconst edge = new Date();\nedge.setUTCDate(edge.getUTCDate() - MAX_AGE_DAYS);\nconst cutoff = edge.toISOString().slice(0, 10);\n\n// В таблицу пишем дату публикации без времени: для отчётности часы не нужны.\nfunction onlyDate(value) {\n  const s = String(value || '');\n  return s.length >= 10 ? s.slice(0, 10) : '';\n}\n\nconst rows = [];\nfor (const item of jobs) {\n  const job = item.json;\n\n  const published = onlyDate(job.date) ||\n    (job.epoch ? onlyDate(new Date(job.epoch * 1000).toISOString()) : '');\n  if (!published || published < cutoff) continue;\n\n  rows.push({\n    json: {\n      job_id: job.id || '',\n      date: published,\n      source: 'RemoteOK',\n      company: job.company || '',\n      position: job.position || '',\n      location: job.location || '',\n      tags: (job.tags || []).join(', '),\n      link: job.apply_url || job.url || '',\n      // описание нужно разметке: грейд и навыки чаще всего именно в нём\n      description: (job.description || '').replace(/<[^>]*>/g, '').slice(0, 600)\n    }\n  });\n}\n\nconsole.log('свежих вакансий: ' + rows.length + ' из ' + jobs.length + ', отсечка ' + cutoff);\nreturn rows;\n"
      },
