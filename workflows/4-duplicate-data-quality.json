    {
      "parameters": {
        "jsCode": "// Получаем все элементы (строки таблицы) из предыдущего узла\nconst items = $input.all();\n\nconst seenJobs = new Set();\nconst cleanItems = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // 1. Извлекаем ключевые поля для проверки (названия могут отличаться, проверьте под свою таблицу)\n  const jobId = data.job_id || data.id || '';\n  const link = data.link || data.url || '';\n  const title = data.position || data.title || '';\n\n  // 2. Проверка качества: отсекаем строки без идентификатора/ссылки или без названия позиции\n  if ((!jobId && !link) || !title) {\n    continue; // Пропускаем пустые или битые строки\n  }\n\n  // 3. Формируем уникальный ключ для дедупликации\n  const uniqueKey = jobId ? jobId.toString().trim() : link.toString().trim();\n\n  if (seenJobs.has(uniqueKey)) {\n    // Если такой ключ уже встречался — это дубль, пропускаем его\n    continue;\n  }\n\n  // Запоминаем уникальный ключ\n  seenJobs.add(uniqueKey);\n\n  // Добавляем чистую уникальную строку в результат\n  cleanItems.push({ json: data });\n}\n\nreturn cleanItems;"
      },
